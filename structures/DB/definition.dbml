Table Notes {
  ID integer [PK, increment]
  User bigint [not null]
  Date bigint [not null]
  Note text [not null]
  Severity varchar(8) [not null]
  Link text
  Noter bigint [not null]
  EditedBy bigint
  EditedDate bigint
  INDEXES {
   User [name: 'user_index'] 
  }
}

Table PlaylistConfig {
  ID integer [PK, increment]
  Month text [not null]
  ThemeTitle text [not null]
  ThemeDescription text
  Current bool
  maxSubmissions integer [Default: 2]
}

Table PlaylistData {
  ID integer [PK, increment]
  User bigint [not null]
  Track text [not null]
  Link text [not null]
  Reasoning text
  Picked bool
  Month integer [Ref: > PlaylistConfig.ID, not null]

  INDEXES {
   Month [name: 'month_index'] 
  }
}

Table Honeypot {
  ID integer [PK, increment]
  BannedCount integer [not null, Default: 0]
}

Table NoteVersions {
  ID integer [PK, increment]
  NoteID integer [Ref: > Notes.ID, not null]
  Version integer [not null]
  Note text [not null]
  Severity varchar(8) [not null]
  Link text
  Editor bigint [not null]
  Date bigint [not null]

  INDEXES {
    (NoteID, Version) [name: 'note_version_idx']
  }
}